# Copy to .env for local development. Never use these example secrets in production.
POSTGRES_DB=logatron
POSTGRES_USER=logatron
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432

CLICKHOUSE_DATABASE=logatron
CLICKHOUSE_USER=logatron_ingest
CLICKHOUSE_PASSWORD=replace-with-a-local-password
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_QUERY_TIMEOUT=5s
CLICKHOUSE_MAX_RESULT_BYTES=8388608
CLICKHOUSE_MAX_CONCURRENT_QUERIES=8

KAFKA_PORT=29092
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
PROCESSOR_PORT=8081
PROCESSOR_BATCH_SIZE=200
PROCESSOR_BATCH_BYTES=4194304
PROCESSOR_FLUSH_INTERVAL=1s
PROCESSOR_DEDUP_WINDOW=10m
METADATA_CACHE_TTL=60s
MAX_EVENT_BYTES=262144
MAX_STACK_TRACE_BYTES=65536

BACKEND_PORT=8080
FRONTEND_PORT=4200
AUTH_PROFILE=dev-auth
DEV_JWT_SECRET=replace-with-at-least-32-random-bytes

# Managed shipper polling/runtime defaults. Each registered server stores its
# own OTLP gateway endpoint because reachability differs between networks.
AGENT_POLL_SECONDS=15
AGENT_STATE_DIRECTORY=/var/lib/logatron-agent

# Required when AUTH_PROFILE is not dev-auth.
OIDC_ISSUER_URI=https://identity.example.test/realms/example
OIDC_AUDIENCE=log-a-tron-api
ALLOWED_ORIGINS=http://localhost:4200
LIVE_MAX_DURATION=5m
LIVE_MAX_CONNECTIONS=4
